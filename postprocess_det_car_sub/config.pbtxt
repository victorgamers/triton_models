name: "postprocess_det_car_sub"
backend: "python"
max_batch_size: 0

input [
   {
     name: "det_input"
     data_type: TYPE_FP32
     dims: [1,25200,6]
   },
   {
      name: "image_input"
      data_type: TYPE_FP32
      dims: [1,3,640,640]
   }
]

output [
    {
        name: "image_output"
        data_type: TYPE_FP32
        dims: [-1,3,48,96]
    }
]


instance_group [
    {
        kind: KIND_CPU
    }
]
