name: "detr"
backend: "onnxruntime"
max_batch_size: 8

input [
  {
    name: "input0"
    data_type: TYPE_FP32
    dims: [3,-1,-1]
  }
]


output [
   {
     name: "output0"
     data_type: TYPE_FP32
     dims: [100,92]
   },
   {
     name: "4994"
     data_type: TYPE_FP32
     dims: [100,4]
   }

]

instance_group [
    {
      count: 1
      kind: KIND_GPU
    }
]