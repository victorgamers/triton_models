name: "yolov7_int8_onnx"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [1,3,640,640]
  }
]

output [
   {
     name: "output"
     data_type: TYPE_FP32
     dims: [-1,-1,-1]
   }
]

instance_group [
    {
      count: 1
      kind: KIND_GPU
    }
]