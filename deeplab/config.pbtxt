name: "deeplab"
backend: "onnxruntime"
max_batch_size: 8


input [
    {
        name: "input0"
        data_type: TYPE_FP32
        dims: [3,513,513]
    }
]

output [
   {
        name: "output0"
        data_type: TYPE_FP32
        dims: [-1,-1,-1]
   }
]


instance_group [
    {
        kind: KIND_GPU
        count: 1
    }
]